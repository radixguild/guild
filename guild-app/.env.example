# Radix Guild Dashboard — Environment Variables
# Copy to .env.local and fill in values.
#
# Required for boot: DATABASE_URL, JWT_SECRET. The app will throw on the
# first request if either is unset (see src/db/index.ts, src/lib/auth.ts).
#
# ⚠️ Safety-critical vars, easy to miss in a long file:
#   GUILD_HALT            — the incident kill switch (see "Runtime halt" below)
#   GUILD_E2E_AUTH_BYPASS — an AUTH BYPASS; e2e-harness only, never set it live
#   NEXT_PUBLIC_FEATURE_* — every user-facing surface is gated behind one of
#                           these; see "Additional feature flags" below and
#                           the "Sprint 1.5: Escrow Marketplace" section

# --- Server-only (required) ---

# Postgres connection string. Required by Drizzle (src/db/index.ts,
# src/db/migrate.ts) and drizzle.config.ts. Local dev tip:
#   docker run -d --name guild-pg -p 5432:5432 -e POSTGRES_PASSWORD=guild postgres:16
DATABASE_URL=postgres://postgres:guild@localhost:5432/guild_dev

# HS256 secret for session JWT cookies (src/lib/auth.ts). Generate with:
#   openssl rand -base64 48
# Rotate by overwriting; all sessions invalidate.
JWT_SECRET=replace-me-with-openssl-rand-base64-48

# --- Server-only (optional) ---

# ROLA expected-origin pin (src/lib/rola.ts). Defaults to https://radixguild.com
# if unset. For local dev set to your dev origin (must match the wallet's
# observed origin) — e.g. http://localhost:3000.
# ROLA_EXPECTED_ORIGIN=http://localhost:3000

# ⚠️ AUTHENTICATION BYPASS — e2e test harness only (src/lib/rola.ts,
# tests/e2e/playwright.config.ts, tests/e2e/helpers.ts). When set to the
# literal string "1", POST /api/v1/auth/verify's verifyAndConsume() accepts
# ANY address with no wallet signature check — the nonce and address-match
# checks still run, the cryptographic step does not. This is a SERVER env
# (not NEXT_PUBLIC_), so it takes effect on the next request with no
# rebuild, and it is compiled into every build regardless — gated solely on
# this var being absent. scripts/launch-check.sh CHECK 6 reads the live pm2
# runtime env (not just dotenv files) and fails a deploy where this is
# armed. Unset = normal signature-checked auth. NEVER set this outside the
# Playwright harness.
# GUILD_E2E_AUTH_BYPASS=1

# --- Public (NEXT_PUBLIC_*) ---

# Used for absolute URLs in metadata + OG image + canonical.
# Override per environment (e.g. staging preview deploys).
NEXT_PUBLIC_SITE_URL=https://radixguild.com

# Radix dApp Definition account address
NEXT_PUBLIC_DAPP_DEF=account_rdx1...

# Radix network — informational only; the app targets mainnet unconditionally
# (network id + gateway are hardcoded in src/lib/radix.ts, not read from here).
NEXT_PUBLIC_RADIX_NETWORK=mainnet

# Badge Manager component address
NEXT_PUBLIC_MANAGER=component_rdx1...

# Badge NFT resource address
NEXT_PUBLIC_BADGE_NFT=resource_rdx1...

# Admin badge resource address
NEXT_PUBLIC_ADMIN_BADGE=resource_rdx1...

# External Radix community bot API base URL. Read by src/lib/config.ts as
# NEXT_PUBLIC_API_URL (exported as BOT_API_URL). Powers home stats, the
# /decisions CV2 feed, /feedback, /groups, and profile contributor data.
NEXT_PUBLIC_API_URL=https://your-api-domain.com/api

# ── Additional feature flags (src/lib/features.ts) ──────────────────────────
# The escrow-related flags (NEXT_PUBLIC_FEATURE_ESCROW / _DISPUTES / _ADMIN)
# are documented further down, under "Sprint 1.5: Escrow Marketplace" — this
# block is the rest of the FLAGS object. Every flag here is read as the exact
# string "true" or "false" and is baked in at build time (NEXT_PUBLIC_): an
# env edit alone does nothing until the app is rebuilt.

# Governance UI (CV2 read-only pages). Code default ON — any value except the
# literal string "false" leaves it showing.
NEXT_PUBLIC_FEATURE_GOVERNANCE=true

# Leaderboard page. Code default ON, same "false"-to-hide pattern as governance.
NEXT_PUBLIC_FEATURE_LEADERBOARD=true

# Grid game (dice rolls -> XP bonus). Default OFF: parked/backlog feature, and
# every /api/v1/game/* route hard-503s while this is false (audit HIGH-003).
# Game bonus XP is a standalone score and never credits users.xp.
NEXT_PUBLIC_FEATURE_GAME=false
# Per-UTC-day roll budget once the game IS on (src/db/queries/game.ts).
# Unset, non-integer, or <= 0 all fall back to 3.
GAME_DAILY_ROLLS=3

# Community-funded tasks (threshold crowdfund). Default OFF, same hard-503
# pattern as `game` (every /api/v1/funding-pools/* route). Flipping this ON
# does NOT move real XRD by itself — the FundingPool Scrypto blueprint it
# composes with does not exist yet; see src/lib/funding-state-machine.ts.
NEXT_PUBLIC_FEATURE_CROWDFUND=false

# In-app notification substrate (#382 — task claimed / submitted / reviewed /
# disputed). Default OFF, same hard-503 pattern as `game`/`crowdfund`. When
# off, emitNotification() (src/lib/notifications.ts) is a cheap no-op instead
# of a DB write. No delivery channel (Telegram/email) exists yet regardless.
NEXT_PUBLIC_FEATURE_NOTIFICATIONS=false

# CV2 on-chain WRITE path (create temperature check / vote). Default OFF —
# the vote leg has never been exercised on mainnet. Does NOT gate the
# read-only CV2 pages, only the write/vote-builder UI.
NEXT_PUBLIC_FEATURE_CV2_WRITES=false

# "Add an agent" dialog on /agents (Bring Your Agent A2.2). Default OFF: the
# dialog hands the owner a one-liner that fetches the kit from /kit/, which
# is not served until the deploy has packed one (see the kit vars below).
NEXT_PUBLIC_FEATURE_AGENTS_ADD=false

# ── Sprint 1.5: Escrow Marketplace (ADR-002) ──────────────────────────
# All escrow features are gated behind NEXT_PUBLIC_FEATURE_ESCROW.
# Code lands inert until the escrow package is published on mainnet.
# See docs/ESCROW-ADDRESSES.md for the deployment runbook.
NEXT_PUBLIC_FEATURE_ESCROW=false

# Dispute UI (raise/resolve/auto-resolve screens). ON is the intended posture
# from P3-3 onward (DB-5, adopted 2026-08-06, gate closed 2026-08-26 when the
# auto-resolve probe on task 3 settled exactly as predicted) — there is
# deliberately no auto-release, so the dispute path is the worker's escape
# from an unresponsive poster, and leaving it off reproduces that stranded
# state. Code default is still OFF when this var is absent (only the literal
# string "true" enables it — src/lib/features.ts): this line is what carries
# the decision into a build, not a change to that default. This is a
# NEXT_PUBLIC_ var, baked at build time: flipping it requires a REBUILD, not
# just an env edit, and unsetting it after a "true" build does NOT turn the
# UI back off. scripts/launch-check.sh CHECK 1/2 now hard-fail a deploy whose
# BUILT ARTIFACT has this baked OFF (the inverse of what they used to guard),
# so a build can only ship without it by someone deliberately overriding the
# gate. See src/lib/features.ts for what the flag does and does not change on
# chain, and docs/AUDITOR-GUIDE.md §6.
NEXT_PUBLIC_FEATURE_DISPUTES=true

# Operator screens: /admin (badge mint/revoke/update-XP transaction builders)
# and /deploy-escrow. The code default is ON, so a deploy bootstrapped from this
# template used to leave both reachable by anyone who guessed the URL — neither
# is in the nav, which made that easy to miss. Closed here on purpose: flip to
# true (and rebuild — this is a NEXT_PUBLIC_ var, baked at build time) only for
# an operator's own build.
NEXT_PUBLIC_FEATURE_ADMIN=false
NEXT_PUBLIC_ESCROW_PACKAGE=
NEXT_PUBLIC_ESCROW_COMPONENT=
NEXT_PUBLIC_ESCROW_RECEIPT_RESOURCE=
# Optional overrides — code defaults (src/lib/config.ts) already target the live
# vNext deployment; set these only to point elsewhere (e.g. a test component).
NEXT_PUBLIC_ESCROW_CLAIM_RECEIPT_RESOURCE=
NEXT_PUBLIC_ESCROW_CLAIM_BOND_XRD=
# Grace period after a claim deadline before expire_claim becomes callable —
# DISPLAY COPY ONLY, same posture as ESCROW_CLAIM_BOND_XRD above; verify
# against the component's get_config before relying on it for anything
# money-path. Unset = 3600 (1h), the live chain-verified value.
NEXT_PUBLIC_ESCROW_EXPIRE_GRACE_SECS=3600
# Human-lane submit deadline, pinned at claim_task (the agent lane uses a
# separate on-chain param) — DISPLAY COPY ONLY, same posture. Unset = 604800
# (7 days), the live chain-verified value.
NEXT_PUBLIC_ESCROW_HUMAN_SUBMIT_DEADLINE_SECS=604800
# Share of a forfeited claim bond paid to whoever calls expire_claim —
# DISPLAY COPY ONLY, read live in expire_claim so a change reaches claims
# already in flight. Unset = 0.1 (10%), the live chain-verified value.
NEXT_PUBLIC_ESCROW_EXPIRE_BOUNTY_PCT=0.1
NEXT_PUBLIC_CV2_COMPONENT=

# ── NFT swap (guild-nft-swap — a separate blueprint in the escrow crate,
# no insurance/claim-bond/review-window/arbiter of its own) ────────────────
# Env first, chain-verified default second (src/lib/config.ts), pinned by
# tests/unit/escrow-address-drift.test.ts. Set only to point at a different
# deployment (e.g. a test component) — unset uses the live mainnet pair.
NEXT_PUBLIC_NFT_SWAP_PACKAGE=
NEXT_PUBLIC_NFT_SWAP_COMPONENT=

# ── Bring Your Agent kit (packages/agent-client, packages/agent-mcp) ───────
# Baked at build time by scripts/deploy.sh from the tarball it just packed
# (see CLAUDE.md's "Kit-hash watcher" section) — not something to hand-set
# outside a deploy. A dev/CI build has no kit: leave these unset and
# src/lib/kit.ts reports KIT_SHA256 / KIT_VERSION as null (the /agents page
# says so rather than printing a placeholder someone could mistake for real).
NEXT_PUBLIC_KIT_TARBALL_URL=
NEXT_PUBLIC_KIT_SHA256=
NEXT_PUBLIC_KIT_VERSION=

# ── x402 agent payments — Track 1 (see docs/research/x402-radix-integration.md) ──
# The whole x402 surface is OFF unless X402_ENABLED=true (routes 404 when unset),
# and INERT (always 402) until src/lib/x402/facilitator.ts is implemented + tested.
X402_ENABLED=false
# REQUIRED when enabled (no default) — the account payments settle to. Confirm the
# correct receiver (ops vs escrow-owner) before enabling; see the doc §8 Q4.
X402_PAY_TO=
# Optional overrides. Asset defaults to the mainnet XRD resource; price is in
# atomic units (18 decimals) — default 50000000000000000 = 0.05 XRD.
X402_ASSET=
X402_FUNDED_TASKS_PRICE=

# ── Agent-lane kill switch (src/lib/config.ts + src/lib/agent-lane.ts) ──────
# Server-enforced OFF switch for the agent work lane (2026-07-31 triage: the
# claimed "agents off" mitigation had no mechanism — this is it). Set to the
# literal string false + restart to turn the lane OFF:
#   POST /api/v1/tasks/[id]/submissions            → 503 AGENT_LANE_OFF
#   POST /api/v1/tasks/[id]/escrow (claim|submit)  → 503 AGENT_LANE_OFF
# Poster-side escrow kinds (create/approve/dispute/resolve/cancel), all reads,
# and escrow/resync stay open so the operator can wind down and the DB can
# still heal toward chain truth. Unset or any other value = LIVE (the default;
# preserves current behavior — the fleet worker earns through this lane).
# Deliberately NOT NEXT_PUBLIC_: it must flip on env change + restart alone,
# with no rebuild, and the client must never be the enforcement point.
# Scope: gates this app only — the deployed blueprint's methods remain PUBLIC
# on-chain; the chain-side gate is the PULL redesign.
AGENT_LANE_LIVE=true

# ── P4: Agent auth (see docs/design/agent-auth-design.md) ──────────────────
# Agent badge resource (operator-minted, recall-revocable). UNSET = the
# builder gate accepts only Guild member badges — agents cannot submit
# (fail-closed dormant). Set after the operator mints the badge resource.
NEXT_PUBLIC_AGENT_BADGE_NFT=

# ── Gifts (/gift — src/lib/gift.ts) ─────────────────────────────────────────
# Gift destinations. There is NO feature flag here on purpose: a rail is live
# if and only if its destination is set and valid, so "configured" and "live"
# cannot drift apart. Each rail is independent — set one, set all four, or set
# none. With none set, /gift returns 404 and the footer link disappears.
#
# INVALID IS TREATED AS UNSET. Values are checked before anything renders
# (bech32m checksum for XRD, bech32/bech32m for bc1… BTC, host allowlist for
# the links). A rejected value logs a [gift] warning at `next build` and its
# rail stays OFF — if you set an address and the rail is still dark, read the
# build output, don't assume the page is broken.
#
# ⚠ OPERATOR CHECK, once per address, BEFORE announcing the page: load /gift on
# the VPS build and scan each QR with the wallet that OWNS the address. Confirm
# it resolves to the account you expect. Code cannot do this for you — a
# checksum proves an address is well-formed, never that it is YOURS.

# Radix account for XRD gifts. Checksum-verified; a one-character typo is
# rejected rather than rendered.
NEXT_PUBLIC_GIFT_XRD_ADDRESS=

# ONE static Bitcoin mainnet cold address (bc1… strongly preferred: bc1 gets a
# FULL bech32 checksum check, so a typo cannot pass. Legacy 1…/3… addresses are
# accepted but only charset+length-checked — base58check needs async SHA-256 —
# so a typo in a legacy address CAN slip through. See src/lib/btc-address.ts).
# Every gift here is publicly linkable to every other, forever; per-donor
# addresses (BIP-47 / xpub derivation) are DEFERRED, not built — they need key
# material this app must never hold.
NEXT_PUBLIC_GIFT_BTC_ADDRESS=

# Stripe Payment Link, created in the Stripe dashboard. Must be a LIVE-mode
# buy.stripe.com/… or donate.stripe.com/… URL — test-mode (/test_…) links are
# rejected, since they look like a working rail while collecting nothing.
# The app only links out: no card data ever touches this site.
NEXT_PUBLIC_GIFT_STRIPE_URL=

# PayPal.me link (https://paypal.me/<handle> or
# https://www.paypal.com/paypalme/<handle>). Link-out only.
NEXT_PUBLIC_GIFT_PAYPAL_URL=

# ── PR auto-verify (lib/pr-verify.ts, TASK-TERMS-DESIGN §8) ─────────────────
# Optional GitHub token: required to verify PRs in PRIVATE repos (guild-saas
# tasks) and raises the API rate limit. Public-repo tasks work without it.
GITHUB_TOKEN=

# ── Price feed (api/v1/quote/xrd-usd/route.ts) ──────────────────────────────
# Override for the Astrolescent XRD/USD partner endpoint. Unset = the
# built-in radixguild partner URL. The route falls back to CoinGecko, then a
# stale cache, then a 503 fail-closed if both sources are down — see that
# file for the full chain and the alert titles it sends.
# ASTROLESCENT_PRICE_URL=

# ── Reporting exclusions (lib/test-accounts.ts — G-508) ─────────────────────
# Comma-separated Radix account addresses to hide from PUBLIC reporting
# surfaces (leaderboard, /api/v1/tasks/stats): test/operator/smoke fleet
# accounts whose payouts credit real XP/reputation but should not appear in
# public metrics. Payouts still credit them — this filters the reporting layer
# only. Leave unset for NO filtering (safe default).
GUILD_TEST_ACCOUNTS=

# ── Keeper (scripts/keeper.mjs — lapsed-dispute finalize) ───────────────────
# Dedicated ZERO-PRIVILEGE account: no badges, no owner powers, just a small
# XRD fee float (~20 XRD). auto_resolve_dispute is a PUBLIC blueprint method —
# the key only locks fees. Leave unset to keep the keeper in dry-run.
KEEPER_PRIVATE_KEY=
KEEPER_ACCOUNT_ADDRESS=

# Telegram transport shared by every cron alert (keeper, escrow-drift-watch,
# mint-volume-watch, task-activity-watch, kit-hash-watch) AND src/lib/tg-alert.ts
# (in-app operator pages, e.g. the price-feed alerts above) — one bot
# (@radix_guild_bot), one operator chat. Unset = every alert path no-ops
# (returns false) and fails soft; nothing throws into a request, but no page
# reaches the operator either.
KEEPER_ALERT_TG_TOKEN=
KEEPER_ALERT_TG_CHAT=

# ── Runtime halt (lib/gateway.ts, api/v1/network/status) ────────────────────
# The manual stop button. Set to "1" or "true" and the site shows an incident
# banner saying WE paused wallet actions; anything else (including unset) is
# off. Deliberately NOT a NEXT_PUBLIC_ flag: those bake at build time, so
# flipping one needs build + launch-check + pm2 restart — minutes, and it
# assumes the deploy chain is healthy, which in an incident is exactly what you
# cannot assume. This is read PER REQUEST, so it takes effect on the next page
# load with no rebuild.
#
# Reading it does NOT stop the escrow component: raise_dispute, withdraw and
# every other blueprint method stay callable by a hand-built manifest, the same
# way the dispute flag never gated the chain. It stops OUR UI offering
# transactions, which is the layer that would have helped on 2026-08-31.
# GUILD_HALT=1
#
# Ledger-tip age (seconds) beyond which the network is reported as halted
# WITHOUT the lever — the automatic half. Mainnet lands rounds in seconds and
# turns epochs over in minutes, so the 600s default sits far outside normal
# jitter. Lower it only if you have measured the false-positive rate.
# GUILD_HALT_AFTER_SECONDS=600

# mint-volume-watch.mjs (cron on the Guild box): default alert threshold, member-badge mints per window
MINT_VOLUME_ALERT_THRESHOLD=20
