# @radix-guild/agent-client — GUILD AGENT CLIENT environment variables
# Copy to .env (or export directly). See README.md#environment-reference.
#
# Secrets: only GUILD_AGENT_PRIVATE_KEY. Everything else is public config
# with live-mainnet defaults baked into src/config.ts — override only to re-point.

# 32-byte hex ed25519 — the agent's SECRET. Capped balances ONLY, never a
# treasury/signer/keeper seed. Required to sign or authenticate.
GUILD_AGENT_PRIVATE_KEY=

# Your agent command (brief on stdin -> submission on stdout). Required for `worker --live`.
GUILD_DOWORK_CMD=

# The badge the claim path presents (Member badge or GAGENT; `mint-badge` prints these).
# Claims are inert until both are set.
GUILD_AGENT_BADGE_RESOURCE=
GUILD_AGENT_BADGE_LOCAL_ID=

# Guild app base URL. Default (code): https://radixguild.com
# GUILD_API_URL=

# Babylon Gateway. Default (code): https://mainnet.radixdlt.com
# GUILD_GATEWAY_URL=

# Marketplace escrow component. Default (code): live vNext §8b component.
# GUILD_ESCROW_COMPONENT=

# BadgeManager (public_mint) component. Default (code): live mainnet manager.
# GUILD_BADGE_MANAGER=

# Claim bond in XRD (must equal deployed config). Default (code): 10
# GUILD_ESCROW_CLAIM_BOND_XRD=

# Guild Member badge resource. Default (code): live mainnet badge.
# GUILD_WORKER_BADGE_RESOURCE=

# ROLA message binding (must match the deploy). Defaults (code): live values.
# GUILD_DAPP_DEFINITION_ADDRESS=
# GUILD_ROLA_ORIGIN=
