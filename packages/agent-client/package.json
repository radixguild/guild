{
  "name": "@radix-guild/agent-client",
  "version": "0.8.1",
  "description": "Programmatic Radix Guild marketplace client — the guild-agent CLI (status/stop/sweep) for a person's own agent, headless ROLA auth, on-chain claim/submit/expire/dispute legs, the guild-worker CLI (doctor/onboard/mint-badge/withdraw) for autonomous workers, and the guild-poster CLI (post/approve/cancel/cancel-after-claim/release-timeout/withdraw) for autonomous posters.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/radixguild/guild.git",
    "directory": "packages/agent-client"
  },
  "homepage": "https://radixguild.com/agents",
  "bugs": {
    "url": "https://radixguild.com/bug-bounty"
  },
  "author": "bigdev (https://github.com/bigdevxrd)",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.map",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/**/*.probe.ts",
    "!src/derive-agent.ts",
    "!src/throwaway-key.ts",
    "!src/update-pilot-env.ts",
    "!src/live-auth-check.ts",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "guild-agent": "./dist/guild-agent.js",
    "guild-worker": "./dist/guild-worker.js",
    "guild-poster": "./dist/guild-poster.js"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "smoke:node": "node dist/guild-agent.js help && node dist/guild-worker.js --help && node dist/guild-poster.js help && node --input-type=module -e \"import('./dist/index.js').then(m => { if (!m.GuildApiClient) throw new Error('index missing GuildApiClient'); console.log('node import ok:', Object.keys(m).length, 'exports') })\"",
    "test": "bun test src/",
    "type-check": "tsc --noEmit",
    "agent": "bun src/guild-agent.ts",
    "worker": "bun src/worker-cli.ts",
    "poster": "bun src/guild-poster.ts",
    "doctor": "bun src/guild-worker.ts doctor",
    "onboard": "bun src/guild-worker.ts onboard",
    "mint-badge": "bun src/guild-worker.ts mint-badge",
    "derive": "bun src/derive-agent.ts",
    "update-pilot-env": "bun src/update-pilot-env.ts",
    "auth:live": "bun src/live-auth-check.ts"
  },
  "dependencies": {
    "@radixdlt/radix-engine-toolkit": "1.0.6",
    "bip39": "3.1.0"
  },
  "devDependencies": {
    "@radixdlt/rola": "2.1.0",
    "bun-types": "1.3.5",
    "@types/node": "20.19.39",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
