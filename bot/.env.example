# Radix Guild bot — environment variables
# Copy to .env and fill in values

# Telegram bot token (from @BotFather)
TG_BOT_TOKEN=

# Telegram admin user IDs (comma-separated)
ADMIN_TG_IDS=

# The bot's own @handle, for "DM me" copy (services/bot-handle.js). Telegram
# already tells the bot its own username at startup (ctx.me), so this is only
# a fallback for contexts with no ctx.me (tests, a handler called pre-init).
# Unset = the literal fallback "@radix_guild_bot".
# BOT_USERNAME=@radix_guild_bot

# Radix account address used to seed the initial working-group leads on first
# boot (db.js) — paired with ADMIN_TG_IDS' first id. Unset = the one-time
# working-group seed is skipped and retried on every later boot until both
# this and ADMIN_TG_IDS are set. Not read anywhere else.
ADMIN_RADIX_ADDRESS=

# ── Signer credentials (services/tx-signer.js, wraps scripts/signer.js) ─────
# NOT configured in production today (bot/README.md) — the signer module
# exists but is inert without these. Unset BOT_PRIVATE_KEY = every signer
# action returns { error: "no_signing_key" } before a manifest is even built
# (the "Guard: env vars" check). Treat both as live money-path secrets: this
# account can RELEASE_TASK / FORCE_CANCEL / EXPIRE_TASK / UPDATE_XP /
# PAY_ARBITER on the components below once armed.
BOT_PRIVATE_KEY=
RADIX_ACCOUNT_ADDRESS=

# ── Radix Gateway ────────────────────────────────────────────────────────
# ⚠️ Two different names, because two different files grew this
# independently — RADIX_GATEWAY (services/gateway.js, services/escrow-
# watcher.js, services/bounty-linkage.js) and RADIX_GATEWAY_URL
# (services/tx-signer.js, and scripts/signer.js which it wraps). Setting only
# one leaves the other half of the bot pointed at the hardcoded mainnet
# default. The OLD documented names here (RADIX_NETWORK, GATEWAY_URL) are
# read by NOTHING in bot/ — editing them had zero effect. Both real vars
# default to https://mainnet.radixdlt.com when unset.
RADIX_GATEWAY=https://mainnet.radixdlt.com
RADIX_GATEWAY_URL=https://mainnet.radixdlt.com

# ── On-chain components ──────────────────────────────────────────────────
# Every address below has a hardcoded mainnet default in code (gateway.js /
# tx-signer.js / bounty-linkage.js) — unset uses that default; set only to
# point at a different deployment (e.g. a test component).
#
# ⚠️ ESCROW_COMPONENT means TWO different components depending on which file
# reads it — gateway.js's own header comment calls this out. In gateway.js
# and tx-signer.js it is the retired V1 TaskEscrow (default
# component_rdx1cp8m…). In escrow-watcher.js it is instead the LIVE Wave B
# PULL escrow (default component_rdx1czka5…, the SAME address as
# ESCROW_PULL_COMPONENT below). There is no way to repoint tx-signer.js at a
# test component without also repointing what escrow-watcher.js watches —
# they share this one var.
ESCROW_COMPONENT=
ESCROW_V3_COMPONENT=
# Optional SECOND component escrow-watcher.js also watches, e.g. across a
# future swap's drain window (services/escrow-watcher.js). Unset = watch
# ESCROW_COMPONENT alone.
ESCROW_SECONDARY_COMPONENT=
# gateway.js / tx-signer.js's own name for the live Wave B PULL escrow — see
# the ESCROW_COMPONENT warning above; escrow-watcher.js watches the SAME
# address under the OTHER var name. This signer's manifests (release_task,
# force_cancel, …) are V1/V3-shaped and do NOT exist on the PULL blueprint —
# PULL settlement is never signed here.
ESCROW_PULL_COMPONENT=
# Comma-separated EXTRA legacy component addresses (on top of the two
# hardcoded V1/V3 ones) that bounty-linkage.js should still treat as
# "legacy escrow" for TX-hash linking. Unset = just the two hardcoded ones.
ESCROW_LEGACY_COMPONENTS=
# Which manifest shape tx-signer.js builds against: "v2" or "v3". Unset = v2.
ESCROW_VERSION=v2
BADGE_MANAGER=
ADMIN_BADGE=
BADGE_NFT=
# CV2 governance component — see CV2_ENABLED below. Unset = "" (consultation.js
# logs "[CV2] Set CV2_COMPONENT env var when governance is deployed to mainnet"
# and the feature stays inert even if CV2_ENABLED=true).
CV2_COMPONENT=

# CORS origins (comma-separated, no wildcards in production)
CORS_ORIGINS=https://radixguild.com

# Internal-route protection is enforced by your reverse proxy (e.g. Caddy),
# not by the bot — no code in this repo reads a shared secret for it.
#INTERNAL_API_SECRET=

# ── HTTP API (services/api.js) ───────────────────────────────────────────
# Unset = binds 127.0.0.1:3003 — loopback only, meant to sit behind the
# reverse proxy (bot/README.md: only /api/agent/* is proxied to the internet).
API_HOST=127.0.0.1
API_PORT=3003

# Bounty/escrow gate — default OFF while the system is being rebuilt in guild-saas.
# When "false" or unset:
#   - POST/GET /api/bounties* → 503 service_unavailable
#   - /bounty Telegram command → "feature being rebuilt" reply
# Set to "true" + pm2 restart to re-enable.
# ⚠️ The pre-rename name was ENABLE_ESCROW — index.js checks for it only to
# warn a box that missed the rename ("FEATURE_ESCROW is UNSET but the
# pre-rename ENABLE_ESCROW is present"). Setting ENABLE_ESCROW has no effect
# on its own; rename it to FEATURE_ESCROW instead of adding it here.
FEATURE_ESCROW=false

# The bot's own legacy in-Telegram bounty board, wizard and milestones
# (bot/README.md's Feature Flags table). Default OFF: /bounty links to the
# web task board instead. Independent of FEATURE_ESCROW, which only gates
# the watcher + API surface, not this board.
FEATURE_LEGACY_BOUNTY=false

# Working-group watcher (charter sunset alerts + overdue bi-weekly report nags,
# every 6h) — default OFF until working groups adopt reports.
FEATURE_WG_WATCHER=false

# Funded-task DM alerts (#119): when the escrow watcher sees a TaskCreatedEvent,
# DM every user who opted in via /taskalerts on. Default OFF.
FEATURE_TASK_ALERTS=false

# The parked CV2 governance reader (bot/README.md's Feature Flags table).
# Default OFF (consultation.js). Needs CV2_COMPONENT set too, above.
CV2_ENABLED=false

# Shared secret gating POST /api/xp/mark-applied (SECURITY 2026-08-16). That route
# is the only WRITE on an otherwise public API surface, and marking XP applied
# DESTROYS the pending queue entry (the batch signer then skips it, so the XP is
# never written to the badge). It FAILS CLOSED: unset ⇒ route returns 401 for
# everyone. There is deliberately NO loopback exemption — Caddy reverse-proxies
# public /api/* traffic to this server over 127.0.0.1, so a loopback check would
# admit the whole internet. Set the SAME value in the environment that runs
# scripts/xp-batch-signer.js. Generate with: openssl rand -hex 32
XP_SIGNER_KEY=

# Support AI — /ask, a support answer grounded ONLY in the guild's own deployed
# docs (BM25 retrieval, no invented answers), generated by a local Ollama model on
# this box. Default OFF: unset/anything but "true" and /ask replies pointing at
# /support instead. Set "true" + pm2 restart once Ollama is installed and serving
# SUPPORT_AI_MODEL locally.
SUPPORT_AI_ENABLED=false

# JSON docs corpus the retriever indexes: { builtAt, commit, pages, chunks }.
# Defaults to "$PORTAL_URL (or https://radixguild.com)/support-corpus.json".
#SUPPORT_AI_CORPUS_URL=

# Local Ollama endpoint + model. qwen2.5:3b is small enough to run alongside the
# bot on the Guild VPS.
OLLAMA_URL=http://127.0.0.1:11434
SUPPORT_AI_MODEL=qwen2.5:3b

# BM25 retrieval gate (0-ish upward) — below this score /ask refuses and offers a
# support ticket instead of calling the model at all.
SUPPORT_AI_MIN_SCORE=2.0

# Ollama call timeout (ms). Local 3B models on a modest VPS CPU can be slow.
SUPPORT_AI_TIMEOUT_MS=90000

# Abuse/cost guards: max /ask questions per user per rolling 10 minutes, and the
# max FIFO queue depth once one answer is already generating — concurrency is
# always exactly 1, since one small VPS should not run two local-model calls at
# once. Beyond the cap, /ask replies "Busy" instead of piling up.
SUPPORT_AI_USER_LIMIT=5
SUPPORT_AI_QUEUE_MAX=5
# --- Escrow watcher replay guard (added 2026-09-05) ---
# escrow-watcher.js only starts when FEATURE_ESCROW=true (see FEATURE_ESCROW
# above) — this keeps a box with escrow disabled from also polling for it.
# ESCROW_WATCHER_MAX_REPLAY: if the stored poll cursor falls this many raw
# ledger state_versions behind the gateway tip (e.g. after an extended
# outage), or the ledger tip hasn't moved since the last poll (a halted
# chain), the watcher skips per-user DMs for that backlog instead of mass-
# replaying it: it fast-forwards its cursor, logs one line, and sends at
# most one operator alert. Optional; defaults to 100000 if unset or invalid.
# ESCROW_WATCHER_MAX_REPLAY=100000

# ── Escrow watcher network tuning (services/escrow-watcher.js) ─────────────
# All optional; unset falls back to the value shown. Debounce is how long an
# unreachable-Gateway incident must persist before it pages (below that it
# self-heals silently); the two timeouts bound one poll's Gateway calls.
ESCROW_WATCHER_ALERT_DEBOUNCE_MS=300000
ESCROW_WATCHER_STREAM_TIMEOUT_MS=30000
ESCROW_WATCHER_POLL_DEADLINE_MS=300000

# Hard ceiling (ms) on every plain Gateway call outside the watcher's own
# timeouts above (services/gateway.js). Unset = 5000.
GATEWAY_TIMEOUT_MS=5000

# ── Wallet link (/link — services/verify.js) ────────────────────────────────
# Proves a Telegram account owns a Radix wallet, via a signed HMAC token
# shared with guild-saas's /link-telegram page — see verify.js's header for
# the token format. linkEnabled requires BOTH this true AND the secret to be
# at least 32 chars; unset or a short secret leaves /link answering as
# disabled regardless of this flag.
WALLET_LINK_ENABLED=false
# Generate with: openssl rand -hex 32
TG_LINK_SECRET=

# Base URL used to build outbound links (Discord/Telegram copy, the support
# corpus URL above, verify.js's /link-telegram page). Unset = https://radixguild.com.
PORTAL_URL=https://radixguild.com

# Per-user command rate limit (services/guards.js createThrottleGuard, wired
# in index.js). Unset = 60 commands per 60000ms (60s) rolling window.
THROTTLE_MAX=60
THROTTLE_WINDOW_MS=60000

# Badge-lookup cache (services/gateway.js) — collapses repeated Gateway reads
# for the same wallet during a burst (badge gate on every vote/command).
# Unset = 30000ms TTL, 2000 entries max (oldest evicted past the cap).
BADGE_CACHE_TTL_MS=30000
BADGE_CACHE_MAX=2000

# HMAC salt for the command-usage logger (index.js createCommandLogger) — logs
# hashed, not raw, identifiers. Unset = the literal string "guild-bot" (fine
# for a single box; set your own if you ever aggregate logs across boxes).
CMD_LOG_SALT=guild-bot

# ── Integrations ─────────────────────────────────────────────────────────
# Discord webhook for cross-posting (index.js notifyDiscord). Unset = skipped.
DISCORD_WEBHOOK_URL=

# RadixTalk (Discourse) integration — ready for API key (services/discourse.js).
# Unset DISCOURSE_API_KEY = "[Discourse] No API key set — skipping post to
# RadixTalk" and the call is skipped; nothing throws.
DISCOURSE_URL=https://radixtalk.com
DISCOURSE_API_KEY=
DISCOURSE_API_USER=system
DISCOURSE_CATEGORY=5

# GitHub PR-merge checker (services/github.js), used by the verification
# system to auto-release escrow when a linked PR merges. Unset = unauthenticated
# calls — fine for public repos, needed for PRIVATE guild-saas task PRs and to
# raise the rate limit (60/hr → 5000/hr).
GITHUB_TOKEN=

# ── Storage ──────────────────────────────────────────────────────────────
# SQLite file path (db.js, services/xp.js). Unset = guild.db next to db.js.
# WAL mode: back it up with `sqlite3 <db> ".backup <file>"`, never a plain
# `cp` of the file alone (bot/README.md).
BOT_DB_PATH=
